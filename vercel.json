{
  "functions": { "api/events.mjs": { "maxDuration": 30 } },
  "headers": [
    {
      "source": "/company-search/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/company-previews/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
